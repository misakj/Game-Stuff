pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- zombie crawl to test what i've learned--
function _init()
cls()
-- position of zombie
zombie_x=10
zombie_y=64

-- zombie speed --
zombiex_speed=1
zombiey_speed=1

-- zombie sprite --
zombie_frame=1
zombie_framel=17

-- brains
brains_spr=6
brains_cnt=3

end


function _update()


	zombiex_speed=0
	zombiey_speed=0
	--zombie_frame=1
	
	-- control zombie --
	if btnp(1) then
		zombiex_speed=3
		zombie_frame+=1
	end

	if btnp(0) then
		zombiex_speed=-3
		zombie_frame+=1
	end
	
	if btnp(2) then
		zombiey_speed=-3
		zombie_frame+=1
	end

	if btnp(3) then
		zombiey_speed=3
		zombie_frame+=1
	end
	
	--update zombie movement
	zombie_x=zombie_x+zombiex_speed
	zombie_y=zombie_y+zombiey_speed
	if zombie_frame >3 then
		zombie_frame=1
	end
	---screen edge detection -- 
	if zombie_x>120 then
		zombie_x=120
	end
	
	if zombie_x<0 then
		zombie_x=0
	end
	
	if zombie_y>120 then
		zombie_y=120
	end
	
	if zombie_y<0 then
		zombie_y=0
	end
	
end

function _draw()
	cls()
	spr(zombie_frame,zombie_x,zombie_y)

	for i=1,4 do
		if brains_cnt>=i then
			spr(6,i*9,2)
		else
			spr(7,i*9,2)
		end
	end
end


