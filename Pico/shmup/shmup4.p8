pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- player controls lesson 3 --
-- init() calls once at start --
function _init()
	cls(1)
	-- position of ship --
	shipx=40
	shipy=64
	-- speed of ship
	shipspdx=1
	shipspdy=1
	
	-- position of bullet
	bullx=64
	bully=40
end
-- update() makes changes on screen --
function _update()

	-- controls --

	shipspdx=0
	shipspdy=0
	if btn(0) then
		shipspdx=-2
	end
	
	if btn(1) then
		shipspdx=2
	end
	
	if btn(2) then
		shipspdy=-2
	end
	
	if btn(3) then
		shipspdy=2
	end
	
	if btnp(5) then
		bullx=shipx
		bully=shipy-3
		sfx(0)
	end

 -- moving the ship --
	shipx=shipx+shipspdx
	shipy=shipy+shipspdy
	
	-- move the bullet --
	bully=bully-3
		
	-- checking for edge of screen --

		if shipx>120 then
	 	shipx=120
		end
	
	 if shipx<0 then
	 	shipx=0
	 end
	 
	 if shipy>120 then
	 	shipy=120
	 	
	 end
	 
	 if shipy<0 then
	 	shipy=0
	 	
	 end
	end
-- draw() draws frame on screen --
function _draw()
	cls(1)
 spr(1,shipx,shipy)
	spr(3,bullx,bully)
	
end	

