pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- init() calls once at start --
function _init()
	cls(21)

	mode="start"
	blinkt=1
	
end
-- update() makes changes on screen --
function _update()
	blinkt+=1
	
	if mode=="game" then
		-- calls tab 2
		update_game()
	elseif mode=="start" then
		-- start screen
		update_start()
	elseif mode=="start" then
		-- start screen
		update_start()
	elseif mode=="over" then
		update_over()
	end
	
end

-- draw() draws frame on screen --
function _draw()

	if mode=="game" then
		-- calls tab 3
		draw_game()
	elseif mode=="start" then
		-- start screen
		draw_start()
	elseif mode=="over" then
		draw_over()
	end
	
end


function startgame()
	-- resets game session
	-- calls init variables again
	mode="game"
		-- position of ship --
	ship={}
	ship.x=64
	ship.y=64
	ship.sx=0
	ship.sy=0
	ship.spr=1
	-- speed of ship
	shipspdx=1
	shipspdy=1
	
		-- ship sprite
	shipspr=1
	flamespr=6
	
	-- position of primary bullet
	bullxp=64
	-- draw frame of bullet off screen
	bullyp=-10
	
	-- position of secondary bullet
	bullxs=64
	bullys=-10

		-- position of special bullet
	bullx3=64
	bully3=-10
	
	-- muzzle flash
	muzzle=0
	

	--score
	score=10000

	--lives
	lives=3
	
	--bomb count
	bombs=3
	
	-- star object
	stars={}
	
	for i=1,100 do
		local newstar={}
		newstar.x=flr(rnd(128))
		newstar.y=flr(rnd(128))
		newstar.spd=rnd(1.5)+0.5
		-- add local newstar array to star object
		add(stars,newstar)
	end
	
	-- bullets object
	buls={}
	
	function bullet_fire()
		local newbul={}
		newbul.x=ship.x
		newbul.y=ship.y-3
		newbul.spr=bulshape
		add(buls, newbul)
		
		local newbul={
			x=ship.x,
			y=ship.y-3
		}
	end
	
	enemies={}
	
	local myen={}
	myen.x=60
	myen.y=5
	myen.spr=16
	
	add(enemies,myen)
	
end


-->8
-- helpers
function starfield()
		for i=1,#stars do
			local mystar=stars[i]
			local scol=6
			
			if mystar.spd<1 then
				scol=1
	 	elseif mystar.spd<1.5 then
			 scol=13
			end
				pset(mystar.x,mystar.y,scol)
		end
end	

function amimatestars()
	
	for i=1,#stars do
		local mystar=stars[i]
		mystar.y=mystar.y+mystar.spd
		if mystar.y>128 then
			mystar.y=mystar.y-128
		end
		--[[ since reference object, 
		doesn't need to write back]]--
	end
	
end

function blink()
	local blinkani={5,5,6,6,7,7,6,6,5}
	
	if blinkt>#blinkani then
		blinkt=1
	end
	return blinkani[blinkt]
end

function drawmyspr(myspr)
	spr(myspr.spr,myspr.x,myspr.y)
end

function col(a,b)
	--lot of math
	
	return false

end
-->8
-- update

function update_game()

	-- controls --

	ship.sx=0
	ship.sy=0
	ship.spr=1
	starx_mv=0
	stary_mv=0
	if btn(0) then
		ship.sx=-2
		ship.sy=2
	end
	
	if btn(1) then
		ship.sx=2
		ship.spr=3
	end
	
	if btn(2) then
		ship.sy=-2
	end
	
	if btn(3) then
		ship.sy=2
		stary_mv=-1
	end
	
	if btnp(5) and not btnp(4) then
		bulshape=32
		bullet_fire()
		sfx(2)
		muzzle=3
	end
	
	if btnp(4) and not btnp(5)  then
		bulshape=48
		bullet_fire()
		sfx(0)
		muzzle=4
	end
	
	if btnp(4) and btnp(5) then
		bulshape=56
		bullet_fire()
		sfx(1)
		muzzle=5
		bombs-=1
	end

 -- moving the ship --
	ship.x+=ship.sx
	ship.y+=ship.sy
	
	-- move the bullet --
	-- loop backwards to allow
	-- bullets to be deleted
	for i=#buls,1,-1 do
		local mybul=buls[i]
			mybul.y=mybul.y-4
			
			if mybul.y<-4 then
				del(buls,mybul)
			end
	end
	
	-- animate enemies
	for myen in all(enemies) do
		myen.y+=1
		myen.spr+=0.3
		if myen.spr>=20 then
			myen.spr=16
		end
		if myen.y>128 then
			del(enemies,myen)
		end
	end
	
	--collison ship x enemies
	for myen in all(enemies) do
		if col(myen,ship) then
			lives-=1
			sfx(0)
		end
	end
	
	-- animate flame --
	flamespr=flamespr+1
	if flamespr>9 then
		flamespr=5
	end
	
	-- animate muzzle
	if muzzle>0 then
		muzzle=muzzle-1
	end
	

	

	
	-- checking for edge of screen --

		if ship.x>120 then
	 	ship.x=120
		end
	
	 if ship.x<0 then
	 	ship.x=0
	 end
	 
	 if ship.y>120 then
	 	ship.y=120
	 end
	 
	 if ship.y<0 then
	 	ship.y=0
	 end
	 
		-- tutorial version to animate stars
	-- first attempt in extra notes and paddle exercise
	amimatestars()
end

function update_start()
	if btnp(4) or btnp(5) then
		startgame()
		
	end
end

function update_over()
		if btnp(4) or btnp(5) then
			mode="start"
	end
end
-->8
-- draw
function draw_game()
	cls(0)
	starfield()
	drawmyspr(ship)
 spr(flamespr,ship.x,ship.y+4)

-- draw bullets
	for mybul in all(buls) do
		drawmyspr(mybul)
	end
	
-- draw enemies
	for myen in all(enemies) do
		drawmyspr(myen)
	end
	
	if muzzle > 0 then
		circfill(ship.x+3, ship.y-2,muzzle,7)
	end
	
	print("score: "..score,40,1,12)
	--lua count starts at 1, not 0
	for i=1,4 do
		if lives>=i then
			spr(12,i*9-8,1)
		else
			spr(11,i*9-8,1)
		end
	end
	
	--bomb count--
		for i=1,3 do
		if bombs>=i then
			spr(56,i*9+90,2)
		else
			spr(57,i*9+90,2)
		end
	end
	print(#buls,5,5,7)
end

function draw_start()
	cls(1)

	print("my awesome shmup",30,45,12) 
	print("press any key to start",20,70,blink())
end

function draw_over()
	cls(8)
	print("game over!",45,45,2) 
	print("press any key to continue",20,70,blink())
end
