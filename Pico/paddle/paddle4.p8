pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- player controls lesson 3 --
-- init() calls once at start --
function _init()
	cls(1)
	-- position of ship --
	shipx=40
	shipy=64
	-- speed of ship
	shipspdx=1
	shipspdy=1
	-- ship sprite
	shipspr=1
	flamespr=6
	
	-- position of primary bullet
	bullxp=64
	-- draw frame of bullet off screen
	bullyp=-10
	
	-- position of secondary bullet
	bullxs=64
	bullys=-10

		-- position of special bullet
	bullx3=64
	bully3=-10
	
	-- muzzle flash
	muzzle=0
	
	-- motion line animation
	motion_line=33
	
end
-- update() makes changes on screen --
function _update()

	-- controls --

	shipspdx=0
	shipspdy=0
	shipspr=1
	if btn(0) then
		shipspdx=-2
		shipspr=2
	end
	
	if btn(1) then
		shipspdx=2
		shipspr=3
	end
	
	if btn(2) then
		shipspdy=-2
	end
	
	if btn(3) then
		shipspdy=2
	end
	
	if btnp(5) and not btnp(4) then
		bullxp=shipx
		bullyp=shipy-3
		sfx(2)
		muzzle=3
	end
	
	if btnp(4) and not btnp(5)  then
		bullxs=shipx
		bullys=shipy-3
		sfx(0)
		muzzle=4
	end
	
	if btnp(4) and btnp(5) then
		bullx3=shipx
		bully3=shipy-3
		sfx(1)
		muzzle=5
	end

 -- moving the ship --
	shipx=shipx+shipspdx
	shipy=shipy+shipspdy
	
	-- move the bullet --
	bullyp=bullyp-3
	bullys=bullys-3
	bully3=bully3-3
	
	-- animate flame --
	flamespr=flamespr+1
	if flamespr>9 then
		flamespr=5
	end
	
	-- animate muzzle
	if muzzle>0 then
		muzzle=muzzle-1
	end
	
	-- animate motion lines --
	motion_line=motion_line+1
	if motion_line>34 then
		motion_line=33
	end
	
	-- checking for edge of screen --

		if shipx>120 then
	 	shipx=120
		end
	
	 if shipx<0 then
	 	shipx=0
	 end
	 
	 if shipy>120 then
	 	shipy=120
	 end
	 
	 if shipy<0 then
	 	shipy=0
	 end
	end
-- draw() draws frame on screen --
function _draw()
	cls(1)
 spr(shipspr,shipx,shipy)
 spr(flamespr,shipx,shipy+4)
	spr(32,bullxp,bullyp)
	spr(48,bullxs,bullys)
	spr(56,bullx3,bully3)
	spr(motion_line,bullxp,bullyp+4)
	
	if muzzle > 0 then
		circfill(shipx+3, shipy-2,muzzle,7)
	end
end	

