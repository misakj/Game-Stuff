pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- player controls lesson 3 --
-- init() calls once at start --
function _init()
	cls(1)
	-- position of ship --
	shipx=40
	shipy=64
	-- speed of ship
	shipspdx=1
	shipspdy=1
	
	-- position of primary bullet
	bullxp=64
	bullyp=40
	
	-- position of secondary bullet
	bullxs=64
	bullys=40
	
		-- position of special bullet
	bullx3=64
	bully3=40
end
-- update() makes changes on screen --
function _update()

	-- controls --

	shipspdx=0
	shipspdy=0
	if btn(0) then
		shipspdx=-2
	end
	
	if btn(1) then
		shipspdx=2
	end
	
	if btn(2) then
		shipspdy=-2
	end
	
	if btn(3) then
		shipspdy=2
	end
	
	if btnp(5) then
		bullxp=shipx
		bullyp=shipy-3
		sfx(0)
	end
	
	if btnp(4) then
		bullxs=shipx
		bullys=shipy-3
		sfx(0)
	end
	
	if btnp(4) and btnp(5) then
		bullx3=shipx
		bully3=shipy-3
		sfx(0)
	end

 -- moving the ship --
	shipx=shipx+shipspdx
	shipy=shipy+shipspdy
	
	-- move the bullet --
	bullyp=bullyp-3
	bullys=bullys-3
	bully3=bully3-3
		
	-- checking for edge of screen --

		if shipx>120 then
	 	shipx=120
		end
	
	 if shipx<0 then
	 	shipx=0
	 end
	 
	 if shipy>120 then
	 	shipy=120
	 	
	 end
	 
	 if shipy<0 then
	 	shipy=0
	 	
	 end
	end
-- draw() draws frame on screen --
function _draw()
	cls(1)
 spr(1,shipx,shipy)
	spr(3,bullxp,bullyp)
	spr(4,bullxs,bullys)
	spr(5,bullx3,bully3)
end	

