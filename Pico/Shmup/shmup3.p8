pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- player controls lesson 3 --
-- init() calls once at start --
function _init()
	cls(1)
	
end
-- draw() draws frame on screen --
function _draw()
	-- clears screen each frame --
	cls(1)
	-- shmup spaceship sprite --
	spr(1,40,30)
	-- shmup enemy sprite --
	spr(2,80,20)
	-- bullet sprite --
	spr(3,60,60)
end
-- update() makes changes on screen --
function _update()
	
end
