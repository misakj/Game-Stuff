pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- moving shmup assets --
-- init() calls once at start --
function _init()
	cls(1)
	harry=90
	mimi=120
	kyle=45
	
end
-- draw() draws frame on screen --
function _draw()
	-- clears screen each frame --
	cls(1)
	-- shmup spaceship sprite --
	print(harry)
	print(mimi)
	print(kyle)
	spr(1,harry,mimi)
	-- shmup enemy sprite --
	spr(2,80,20)
	-- bullet sprite --
	spr(3,60,60)
	rect(84,64,64,84,kyle)
	circfill(50,41,10,kyle)
end
-- update() makes changes on screen --
function _update()
	kyle=kyle-1
	mimi=harry+kyle
	
end
